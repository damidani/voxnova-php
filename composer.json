{
  "name": "voxnova/sdk",
  "description": "SDK PHP de la plateforme VoxNova : API REST (SMS, endpoints, numéros, appels, scénarios d'appel, espace revendeur), instructions vocales, vérification des webhooks",
  "type": "library",
  "license": "MIT",
  "keywords": ["voip", "sip", "telephony", "webhooks", "ivr", "voxnova"],
  "homepage": "https://github.com/damidani/voxnova-php",
  "support": { "issues": "https://github.com/damidani/voxnova-php/issues", "source": "https://github.com/damidani/voxnova-php" },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": { "VoxNova\\": "src/" }
  },
  "scripts": {
    "test": "php tests/run.php"
  }
}
